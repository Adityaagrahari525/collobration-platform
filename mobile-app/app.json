{
  "expo": {
    "name": "CampusLink — Academic Network",
    "slug": "campuslink-academic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00236f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.campuslink.academic"
    },
    "android": {
      "package": "org.campuslink.academic",
