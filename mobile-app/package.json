{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "^57.0.16",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.50.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:unit": "npx tsx -e \"import run from './tests/algorithms.test'; const res = run(); if (res.failed > 0) process.exit(1);\"",
    "test:e2e": "npx tsx -e \"import run from './tests/e2eIntegration.test'; run().then(res => { if (res.failed > 0) process.exit(1); })\"",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "private": true
}
